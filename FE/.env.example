# Biến môi trường kết nối API Backend khi deploy lên Netlify
# Nếu để trống, mặc định sẽ kết nối tới http://localhost:5000/api khi chạy nội bộ
# Khi deploy lên Netlify, hãy điền URL máy chủ Backend của bạn (ví dụ trên Render, Railway, VPS...):
# VITE_API_URL=https://your-backend-api.onrender.com/api
VITE_API_URL=
